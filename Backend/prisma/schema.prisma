// Prisma schema for StudentBites

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ------------------------------- Enums -------------------------------- ///

enum ActivityLevel {
  SEDENTARY // ít vận động
  LIGHT // vận động nhẹ 1-3 buổi/tuần
  MODERATE // vận động vừa 3-5 buổi/tuần
  ACTIVE // vận động nhiều 6-7 buổi/tuần
  VERY_ACTIVE // vận động rất nhiều / lao động nặng
}

enum Goal {
  GAIN_MUSCLE
  LOSE_FAT
  MAINTAIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum StoreType {
  MARKET // chợ truyền thống
  SUPERMARKET // siêu thị
  CONVENIENCE // cửa hàng tiện lợi / bách hóa
  ONLINE // website TMĐT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum MatchSource {
  NONE // chưa map được về nguyên liệu nào
  AUTO_KEYWORD // crawler tự map bằng Ingredient.keywords
  MANUAL // người sửa tay — lượt crawl sau KHÔNG được ghi đè
}

enum CrawlStatus {
  RUNNING // đang chạy
  SUCCESS // mọi danh mục đều lấy được
  PARTIAL // có danh mục hỏng nhưng vẫn lấy được dữ liệu
  FAILED // không lấy được gì
}

/// ------------------------------- Models ------------------------------- ///

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  profile      Profile?
  mealPlans    MealPlan[]
  mealLogs     MealLog[]
  priceAlerts   PriceAlert[]
  notifications Notification[]
}

model Profile {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm      Float
  weightKg      Float
  age           Int
  gender        String // 'male' | 'female'
  activityLevel ActivityLevel @default(MODERATE)
  goal          Goal          @default(GAIN_MUSCLE)
  monthlyBudget Int // VND
  updatedAt     DateTime      @updatedAt
}

model Ingredient {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  category        String // protein / carb / rau củ / gia vị ...
  unit            String           @default("g") // đơn vị cơ bản
  proteinPer100g  Float
  carbPer100g     Float
  fatPer100g      Float
  kcalPer100g     Float
  keywords        String[]         @default([]) // dùng để match sản phẩm khi crawl
  dishIngredients DishIngredient[]
  products        Product[]
  priceAlerts PriceAlert[]
}

model Store {
  id         Int             @id @default(autoincrement())
  name       String
  type       StoreType
  address    String?
  lat        Float?
  lng        Float?
  sourceSite String? // bachhoaxanh | winmart | coopmart | osm
  /// Định danh ổn định của một nguồn crawl. Null với cửa hàng lấy từ OSM.
  /// Có cột này thì crawler tra cửa hàng bằng findUnique thay vì findFirst
  /// trên sourceSite (không unique nên kết quả không xác định).
  code       String?         @unique
  osmId      String?         @unique // id từ OpenStreetMap nếu có
  products   Product[]
  categories StoreCategory[]
}

model Dish {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  description   String?
  mealTypes     MealType[] // món này phù hợp cho bữa nào
  // Giá trị dinh dưỡng + chi phí cho 1 khẩu phần (tính sẵn từ nguyên liệu)
  protein       Float
  carb          Float
  fat           Float
  kcal          Float
  estimatedCost Int // VND / khẩu phần (giá tham khảo, cập nhật từ crawler)
  ingredients   DishIngredient[]
  planItems     MealPlanItem[]
  mealLogs      MealLog[]
}

model DishIngredient {
  id           Int        @id @default(autoincrement())
  dishId       Int
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  amountGrams  Float // định lượng cho 1 khẩu phần

  @@unique([dishId, ingredientId])
}

model MealPlan {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  createdAt DateTime       @default(now())
  items     MealPlanItem[]

  @@unique([userId, date])
}

model MealPlanItem {
  id            Int      @id @default(autoincrement())
  mealPlanId    Int
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType      MealType
  dishId        Int
  dish          Dish     @relation(fields: [dishId], references: [id])
  estimatedCost Int // VND, chốt tại thời điểm tạo plan
}

/// Danh mục của một sàn. Trước đây danh sách đường dẫn nằm cứng trong từng
/// file crawler; đưa vào DB thì URL đổi là sửa ngay trên trang quản trị,
/// không phải sửa mã rồi triển khai lại — đúng thứ đang làm WinMart và Co.op
/// chết.
model StoreCategory {
  id         Int             @id @default(autoincrement())
  storeId    Int
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  path       String // đường dẫn tương đối, vd "/c/thit-heo"
  name       String // tên hiển thị, vd "Thịt heo"
  isActive   Boolean         @default(true) // tắt tạm danh mục hỏng mà không xoá
  lastOkAt   DateTime? // lần gần nhất crawl ra được sản phẩm
  lastStatus Int? // mã HTTP lần chạy gần nhất
  note       String?
  products   Product[]
  crawlLogs  CrawlCategory[]

  @@unique([storeId, path])
  @@index([storeId, isActive])
}

/// Sản phẩm CÓ THẬT trên kệ của một sàn.
///
/// Tách khỏi Ingredient vì hai thứ khác nhau: công thức cần 200g gạo, còn
/// ngoài siêu thị chỉ bán bao 5kg. Ingredient là khái niệm nấu ăn, Product là
/// thứ mua được. Giá luôn thuộc về Product, giá của nguyên liệu là suy ra.
model Product {
  id              String         @id @default(uuid())
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeCategoryId Int?
  storeCategory   StoreCategory? @relation(fields: [storeCategoryId], references: [id], onDelete: SetNull)

  sku      String // mã sản phẩm trên sàn
  name     String
  url      String?
  imageUrl String?

  currentPrice Decimal? @db.Decimal(12, 2)
  isInStock    Boolean  @default(true)

  rawUnit         String? // lấy thô từ web: "300g", "0.5KG", "Gói"
  /// Khối lượng đã quy ra gram. NULL nghĩa là CHƯA ĐỌC ĐƯỢC — cố ý không đoán
  /// 1kg như trước, vì đoán sai làm giá mỗi gram lệch nhiều lần.
  baseWeightGrams Int?
  /// Tính sẵn để so sánh và sắp xếp. NULL khi thiếu giá hoặc thiếu khối lượng.
  pricePerGram    Decimal? @db.Decimal(12, 4)

  /// Phần dữ liệu mỗi sàn một kiểu: khuyến mãi, thương hiệu, mã kho, đánh giá…
  metadata Json?

  ingredientId   Int? // null = chưa map được về nguyên liệu nào
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  matchSource    MatchSource @default(NONE)
  matchedKeyword String? // keyword nào đã khớp, để soi lại khi map sai

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) // không thấy nữa = sàn đã gỡ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory ProductPriceHistory[]

  @@unique([storeId, sku])
  @@index([ingredientId, isInStock])
  @@index([storeId, isInStock])
  @@index([storeCategoryId])
}

/// Diễn biến giá của một sản phẩm. Chỉ ghi thêm, và chỉ ghi khi giá hoặc
/// tình trạng còn hàng khác lần quan sát trước.
model ProductPriceHistory {
  id         Int       @id @default(autoincrement())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal   @db.Decimal(12, 2)
  isInStock  Boolean
  crawlRunId Int?
  crawlRun   CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  recordedAt DateTime  @default(now())

  @@index([productId, recordedAt])
  @@index([recordedAt])
}

/// Một lượt crawl của MỘT nguồn. Mỗi lần chạy runner sinh ra 3 dòng (mỗi
/// site một dòng), nhờ vậy trả lời được "hôm nay site nào hỏng, từ bao giờ".
model CrawlRun {
  id            Int                   @id @default(autoincrement())
  sourceSite    String // trùng Store.code
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  status        CrawlStatus           @default(RUNNING)
  productsFound Int                   @default(0) // số sản phẩm bóc được từ HTML
  matched       Int                   @default(0) // số khớp được về Ingredient
  pricesChanged Int                   @default(0) // số giá thật sự khác lần trước
  errorMessage  String? // lỗi ở mức toàn site
  categories    CrawlCategory[]
  priceHistory  ProductPriceHistory[]

  @@index([sourceSite, startedAt])
  @@index([startedAt])
}

/// Kết quả từng danh mục trong một lượt crawl. Đây là chỗ trả lời câu
/// "đường dẫn nào đang 404" mà không phải chạy lại crawler để xem log.
model CrawlCategory {
  id              Int            @id @default(autoincrement())
  crawlRunId      Int
  crawlRun        CrawlRun       @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  storeCategoryId Int? // danh mục trong cấu hình, null nếu chạy đường dẫn rời
  storeCategory   StoreCategory? @relation(fields: [storeCategoryId], references: [id], onDelete: SetNull)
  path            String // đường dẫn tương đối
  url             String // URL đầy đủ đã gọi
  httpStatus      Int? // null nếu lỗi mạng, không có phản hồi
  productsFound   Int            @default(0)
  durationMs      Int?
  errorMessage    String?

  @@index([crawlRunId])
}

/// Nhật ký thao tác của khu quản trị. Chỉ ghi thêm, không sửa không xoá —
/// nhật ký sửa được thì không còn là nhật ký.
model AdminAuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int // id người thực hiện, không đặt quan hệ để xoá user vẫn giữ vết
  actorEmail String
  action     AuditAction
  model      String // tên bảng bị tác động
  recordId   String // id bản ghi, để chuỗi cho hợp mọi kiểu khoá
  changes    Json? // CREATE: dữ liệu tạo · UPDATE: {truoc, sau} · DELETE: bản ghi cũ
  createdAt  DateTime    @default(now())

  @@index([model, recordId])
  @@index([createdAt])
}

/// Cảnh báo giảm giá do người dùng đặt. Khi giá một nguyên liệu giảm đủ ngưỡng
/// thì hệ thống tự tạo Notification.
model PriceAlert {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  thresholdPct Int        @default(10) // giảm ≥ X% thì báo
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, ingredientId])
  @@index([ingredientId, isActive])
}

/// Thông báo gửi đến người dùng (giá giảm, nguyên liệu hết hàng…).
/// Chỉ ghi, ít khi sửa — readAt là dấu đã xem.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'price_drop', 'back_in_stock' …
  title     String // "Ức gà giảm 15% tại Bách Hóa Xanh"
  payload   Json // {ingredientId, ingredientName, productName, store, oldPrice, newPrice, dropPct}
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model MealLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  mealType   MealType
  dishId     Int? // null nếu là món tự nhập ngoài danh sách
  dish       Dish?    @relation(fields: [dishId], references: [id])
  customName String? // tên món tự nhập
  protein    Float
  carb       Float
  fat        Float
  kcal       Float
  cost       Int // VND thực chi
  eatenAt    DateTime @default(now())
}
