// Prisma schema for StudentBites

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ------------------------------- Enums -------------------------------- ///

enum ActivityLevel {
  SEDENTARY // ít vận động
  LIGHT // vận động nhẹ 1-3 buổi/tuần
  MODERATE // vận động vừa 3-5 buổi/tuần
  ACTIVE // vận động nhiều 6-7 buổi/tuần
  VERY_ACTIVE // vận động rất nhiều / lao động nặng
}

enum Goal {
  GAIN_MUSCLE
  LOSE_FAT
  MAINTAIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum StoreType {
  MARKET // chợ truyền thống
  SUPERMARKET // siêu thị
  CONVENIENCE // cửa hàng tiện lợi / bách hóa
  ONLINE // website TMĐT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum CrawlStatus {
  RUNNING // đang chạy
  SUCCESS // mọi danh mục đều lấy được
  PARTIAL // có danh mục hỏng nhưng vẫn lấy được dữ liệu
  FAILED // không lấy được gì
}

/// ------------------------------- Models ------------------------------- ///

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  profile      Profile?
  mealPlans    MealPlan[]
  mealLogs     MealLog[]
}

model Profile {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm      Float
  weightKg      Float
  age           Int
  gender        String // 'male' | 'female'
  activityLevel ActivityLevel @default(MODERATE)
  goal          Goal          @default(GAIN_MUSCLE)
  monthlyBudget Int // VND
  updatedAt     DateTime      @updatedAt
}

model Ingredient {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  category        String // protein / carb / rau củ / gia vị ...
  unit            String            @default("g") // đơn vị cơ bản
  proteinPer100g  Float
  carbPer100g     Float
  fatPer100g      Float
  kcalPer100g     Float
  keywords        String[]          @default([]) // dùng để match sản phẩm khi crawl
  dishIngredients DishIngredient[]
  prices          IngredientPrice[]
  priceHistory    PriceHistory[]
}

model Store {
  id           Int               @id @default(autoincrement())
  name         String
  type         StoreType
  address      String?
  lat          Float?
  lng          Float?
  sourceSite   String? // bachhoaxanh | winmart | coopmart | osm
  /// Định danh ổn định của một nguồn crawl. Null với cửa hàng lấy từ OSM.
  /// Có cột này thì crawler tra cửa hàng bằng findUnique thay vì findFirst
  /// trên sourceSite (không unique nên kết quả không xác định).
  code         String?           @unique
  osmId        String?           @unique // id từ OpenStreetMap nếu có
  prices       IngredientPrice[]
  priceHistory PriceHistory[]
}

model IngredientPrice {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  storeId      Int
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productName  String // tên sản phẩm gốc trên website
  price        Int // VND cho unitQty
  unitQty      Float // số gram (hoặc đơn vị) tương ứng với price
  pricePerUnit Float // VND trên 1g — để so sánh nhanh
  productUrl   String?
  crawledAt    DateTime   @default(now())

  @@unique([ingredientId, storeId, productName])
}

model Dish {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  description   String?
  mealTypes     MealType[] // món này phù hợp cho bữa nào
  // Giá trị dinh dưỡng + chi phí cho 1 khẩu phần (tính sẵn từ nguyên liệu)
  protein       Float
  carb          Float
  fat           Float
  kcal          Float
  estimatedCost Int // VND / khẩu phần (giá tham khảo, cập nhật từ crawler)
  ingredients   DishIngredient[]
  planItems     MealPlanItem[]
  mealLogs      MealLog[]
}

model DishIngredient {
  id           Int        @id @default(autoincrement())
  dishId       Int
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  amountGrams  Float // định lượng cho 1 khẩu phần

  @@unique([dishId, ingredientId])
}

model MealPlan {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  createdAt DateTime       @default(now())
  items     MealPlanItem[]

  @@unique([userId, date])
}

model MealPlanItem {
  id            Int      @id @default(autoincrement())
  mealPlanId    Int
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType      MealType
  dishId        Int
  dish          Dish     @relation(fields: [dishId], references: [id])
  estimatedCost Int // VND, chốt tại thời điểm tạo plan
}

/// Một lượt crawl của MỘT nguồn. Mỗi lần chạy runner sinh ra 3 dòng (mỗi
/// site một dòng), nhờ vậy trả lời được "hôm nay site nào hỏng, từ bao giờ".
model CrawlRun {
  id            Int             @id @default(autoincrement())
  sourceSite    String // trùng Store.code
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  status        CrawlStatus     @default(RUNNING)
  productsFound Int             @default(0) // số sản phẩm bóc được từ HTML
  matched       Int             @default(0) // số khớp được về Ingredient
  pricesChanged Int             @default(0) // số giá thật sự khác lần trước
  errorMessage  String? // lỗi ở mức toàn site
  categories    CrawlCategory[]
  priceHistory  PriceHistory[]

  @@index([sourceSite, startedAt])
  @@index([startedAt])
}

/// Kết quả từng danh mục trong một lượt crawl. Đây là chỗ trả lời câu
/// "đường dẫn nào đang 404" mà không phải chạy lại crawler để xem log.
model CrawlCategory {
  id            Int      @id @default(autoincrement())
  crawlRunId    Int
  crawlRun      CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  path          String // đường dẫn tương đối trong CATEGORY_PATHS
  url           String // URL đầy đủ đã gọi
  httpStatus    Int? // null nếu lỗi mạng, không có phản hồi
  productsFound Int      @default(0)
  durationMs    Int?
  errorMessage  String?

  @@index([crawlRunId])
}

/// Lịch sử giá, chỉ ghi thêm không sửa. IngredientPrice giữ giá HIỆN TẠI
/// (upsert, tra cứu nhanh cho màn so giá); bảng này giữ diễn biến theo thời
/// gian để vẽ được "giá ức gà 30 ngày qua".
///
/// Chỉ ghi khi giá KHÁC lần quan sát gần nhất — crawl mỗi ngày mà giá đứng
/// yên thì không sinh dòng mới.
model PriceHistory {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  storeId      Int
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productName  String // tên sản phẩm gốc, giữ lại vì có thể đổi theo thời gian
  price        Int // VND cho unitQty
  unitQty      Float // gram
  pricePerUnit Float // VND trên 1g — để so sánh và vẽ biểu đồ
  crawlRunId   Int? // lượt crawl nào quan sát được, null nếu nhập tay/seed
  crawlRun     CrawlRun?  @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  recordedAt   DateTime   @default(now())

  @@index([ingredientId, storeId, recordedAt])
  @@index([recordedAt])
}

/// Nhật ký thao tác của khu quản trị. Chỉ ghi thêm, không sửa không xoá —
/// nhật ký sửa được thì không còn là nhật ký.
model AdminAuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int // id người thực hiện, không đặt quan hệ để xoá user vẫn giữ vết
  actorEmail String
  action     AuditAction
  model      String // tên bảng bị tác động
  recordId   String // id bản ghi, để chuỗi cho hợp mọi kiểu khoá
  changes    Json? // CREATE: dữ liệu tạo · UPDATE: {truoc, sau} · DELETE: bản ghi cũ
  createdAt  DateTime    @default(now())

  @@index([model, recordId])
  @@index([createdAt])
}

model MealLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  mealType   MealType
  dishId     Int? // null nếu là món tự nhập ngoài danh sách
  dish       Dish?    @relation(fields: [dishId], references: [id])
  customName String? // tên món tự nhập
  protein    Float
  carb       Float
  fat        Float
  kcal       Float
  cost       Int // VND thực chi
  eatenAt    DateTime @default(now())
}
