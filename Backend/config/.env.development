## Environment ##
NODE_ENV=development


## Server ##
PORT=3001
HOST=localhost


## Database ##
DATABASE_URL=postgresql://studentbites:studentbites@localhost:5434/studentbites?schema=public


## Auth ##
JWT_SECRET=dev-secret-change-me
COOKIE_SECURE=false


## Setup jet-logger ##
JET_LOGGER_MODE=console
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=true
JET_LOGGER_FORMAT=line



## Admin ##
# Email được vào /admin, ngăn cách bằng dấu phẩy. Để trống = chặn tất cả.
ADMIN_EMAILS=loc@demo.vn


## Redis (hàng đợi job) ##
REDIS_URL=redis://localhost:6381
