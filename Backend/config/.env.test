## Environment ##
NODE_ENV=test


## Server ##
PORT=4000
HOST=localhost


## Database ##
DATABASE_URL=postgresql://studentbites:studentbites@localhost:5434/studentbites_test?schema=public


## Auth ##
JWT_SECRET=test-secret
COOKIE_SECURE=false


## Setup jet-logger ##
JET_LOGGER_MODE=console
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=true
JET_LOGGER_FORMAT=line


## Admin ##
# Email được vào /admin, ngăn cách bằng dấu phẩy. Để trống = chặn tất cả.
ADMIN_EMAILS=loc@demo.vn


## Redis (hàng đợi job) ##
REDIS_URL=redis://localhost:6381


## OpenAI (trợ lý chat) ##
OPENAI_API_KEY=
